

[org.gnome.shell]
disable-user-extensions=false
#disabled-extensions=@as []
disabled-extensions=['ubuntu-dock@ubuntu.com', 'gtk4-ding@smedius.gitlab.com', 'snapd-prompting@canonical.com', 'snapd-search-provider@canonical.com', 'tiling-assistant@ubuntu.com', 'web-search-provider@ubuntu.com', 'status-icons@gnome-shell-extensions.gcampax.github.com']
enabled-extensions=['user-theme@gnome-shell-extensions.gcampax.github.com', 'blur-my-shell@aunetx', 'arcmenu@arcmenu.com', 'date-menu-formatter@marcinjakubowski.github.com', 'dash-to-panel@jderose9.github.com', 'ding@rastersoft.com', 'ubuntu-appindicators@ubuntu.com']




[org.gnome.shell.extensions.user-theme]
name='Orchis-Dark'




[org.gnome.shell.extensions.dash-to-dock]
background-opacity=0.70
custom-theme-shrink=true
customize-alphas=true
dash-max-icon-size=32
dock-fixed=true
dock-position='BOTTOM'
height-fraction=0.60
max-alpha=0.50
min-alpha=0.20
scroll-action='switch-workspace'
show-mounts=false
show-trash=false
transparency-mode='DYNAMIC'




[org.gnome.shell.extensions.apps-menu]
apps-menu-toggle-menu=['<Alt>F1']
